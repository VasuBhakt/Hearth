# Candidate Scheduling Window (Hours 0-23)
SCHEDULE_START_HOUR = "9"
SCHEDULE_END_HOUR = "17"

# Travel & Routing Defaults
DEFAULT_DRIVE_SPEED_KMH = "45.0"
DEFAULT_TRAFFIC_BUFFER_MINUTES = "10"

# Weather Engine & Adaptation Thresholds
OPEN_METEO_API_URL = "https://api.open-meteo.com/v1/forecast"
OPEN_METEO_DAILY_METRICS = "temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code"
