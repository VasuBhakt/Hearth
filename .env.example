# ============================================================================
# Hearth Environment Configuration (.env)
# 100% Configurable - Zero Hardcoding
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Server & Protocol
# ----------------------------------------------------------------------------
PORT="8000"
HOST="127.0.0.1"
MIN_PROTOCOL_VERSION="2025-11-25"
CURRENT_PROTOCOL_VERSION="2026-07-28"
HEARTH_DB_PATH="hearth.db"
MCP_SERVER_NAME="hearth-server"
MCP_SERVER_VERSION="0.1.0"

# ----------------------------------------------------------------------------
# 2. Family Preferences & Locations
# ----------------------------------------------------------------------------
DEFAULT_HOME_NAME="Home"
DEFAULT_HOME_LATITUDE="40.6782"
DEFAULT_HOME_LONGITUDE="-73.9442"
DEFAULT_ARRIVAL_BUFFER_MINUTES="30"

DEFAULT_VENUE_NAME="City Sports Complex"
DEFAULT_VENUE_LATITUDE="40.7128"
DEFAULT_VENUE_LONGITUDE="-74.0060"

DEFAULT_EVENT_DURATION_HOURS="2.0"
DEFAULT_TARGET_DATE="2026-10-17"
DEFAULT_TARGET_TIME="09:00:00"
DEFAULT_ARRIVAL_DATETIME="2026-10-17T09:00:00"

# Default Packing & Preference Lists (comma-separated or JSON list)
DEFAULT_SAVED_SNACKS="Orange slices, Granola bars, Electrolyte drinks, Ice pack"

# Candidate Scheduling Window (Hours 0-23)
SCHEDULE_START_HOUR="9"
SCHEDULE_END_HOUR="17"

# ----------------------------------------------------------------------------
# 3. Travel & Routing Defaults
# ----------------------------------------------------------------------------
DEFAULT_DRIVE_SPEED_KMH="45.0"
DEFAULT_TRAFFIC_BUFFER_MINUTES="10"
MIN_DRIVE_TIME_MINUTES="10"

# ----------------------------------------------------------------------------
# 4. Weather Engine & Adaptation Thresholds
# ----------------------------------------------------------------------------
OPEN_METEO_API_URL="https://api.open-meteo.com/v1/forecast"
OPEN_METEO_DAILY_METRICS="temperature_2m_max,temperature_2m_min,precipitation_probability_max,weather_code"
OPEN_METEO_TIMEZONE="auto"
OPEN_METEO_TIMEOUT_SECONDS="4.0"

WEATHER_RAIN_THRESHOLD_PERCENT="40.0"
WEATHER_COLD_THRESHOLD_C="12.0"
WEATHER_HOT_THRESHOLD_C="28.0"

# Offline / Bundled Fallback Weather Forecast
FALLBACK_WEATHER_TEMP_C="16.5"
FALLBACK_WEATHER_CONDITION="Light Rain / Showers"
FALLBACK_WEATHER_PRECIP_PERCENT="75.0"
FALLBACK_WEATHER_WIND_KPH="22.0"
FALLBACK_WEATHER_RAIN_WARNING="true"

# ----------------------------------------------------------------------------
# 5. Generic Matching Lists & Keywords (Zero Hardcoding)
# ----------------------------------------------------------------------------
LOCATION_KEYWORD_MATCHES="home, origin, base, start, dep"
PACKING_KEYWORD_MATCHES="snack, pack, gear, item, check, suppl, food, chair, towel, water, umbrella"
EVENT_TEXT_FIELDS="title, description, category, summary, notes"
BUFFER_KEYWORD_MATCHES="buffer"
RAIN_WEATHER_KEYWORDS="rain, storm, drizzle, shower"
COLD_WEATHER_KEYWORDS="cold, snow, ice, freeze, chill"
HOT_WEATHER_KEYWORDS="hot, sunny, heat"

# ----------------------------------------------------------------------------
# 6. Security, Approval Gate & Undo Ledger (Zero Hardcoding)
# ----------------------------------------------------------------------------
APPROVAL_TOKEN_TTL_MINUTES="15"
APPROVAL_TOKEN_LENGTH_BYTES="32"
UNDO_LEDGER_MAX_ENTRIES="50"
DEFAULT_PLAN_STATUS_DRAFT="draft"
DEFAULT_PLAN_STATUS_COMMITTED="committed"
ACTION_TYPE_COMMIT_PLAN="commit_plan"
ACTION_TYPE_RESCHEDULE="reschedule_event"
ACTION_TYPE_DELETE_EVENT="delete_event"
MAX_SLOT_SEARCH_DAYS="14"
DEFAULT_SLOT_SEARCH_HOUR="10"
WEEKDAY_WORKDAY_MAX="5"
# Conversation memory: max turns (user+assistant pairs) kept per browser session
CONVERSATION_HISTORY_MAX_TURNS="20"

# ----------------------------------------------------------------------------
# 7. Assistant Simulator Web UI Settings (Zero Hardcoding)
# ----------------------------------------------------------------------------
SIMULATOR_PORT="8080"
SIMULATOR_HOST="127.0.0.1"
DEFAULT_DEMO_SCENARIO_PROMPT="Get us ready for Saturday's tournament"
SIMULATOR_TITLE="Hearth Family Assistant"

# ----------------------------------------------------------------------------
# 8. AI Agent / LLM Settings (Zero Hardcoding)
# ----------------------------------------------------------------------------
LLM_PROVIDER="groq"

# Groq Cloud API
GROQ_API_URL="https://api.groq.com/openai/v1/chat/completions"
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TEMPERATURE="0.2"
GROQ_TIMEOUT_SECONDS="30.0"

# Local Ollama
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_TIMEOUT_SECONDS="90.0"

# AWS Bedrock (Optional)
AWS_REGION="us-east-1"
AWS_BEDROCK_MODEL="amazon.nova-lite-v1:0"

# ----------------------------------------------------------------------------
# 9. Natural Language Signals & Router Keywords (Zero Hardcoding)
# ----------------------------------------------------------------------------
PLAN_CANCEL_KEYWORDS="cancel plan, cancel the plan, cancel this plan, remove plan, remove the plan, remove this plan, delete plan, delete the plan, delete this plan, clear plan, clear the plan, discard plan, discard the plan, drop plan, drop the plan, dismiss plan, dismiss the plan, forget plan, forget the plan, start over, remove card, cancel card"
GREETING_KEYWORDS="hi, hello, hey, help, who are you, what can you do"
ADD_EVENT_KEYWORDS="add event, add another event, create event, new event, schedule event"
DELETE_EVENT_KEYWORDS="remove event, remove the event, delete event, delete the event, cancel event, cancel the event, drop event"
REVISION_KEYWORDS="move, reschedule, shift, pack, leave, earlier, later, add to packing"
SCHEDULE_KEYWORDS="schedule, events, calendar, agenda, what's on, what is on, what do we have"
PLANNING_SIGNALS="tournament, saturday, weekend, prepare, ready, plan, organize, what should we do, get us ready, upcoming, fix, resolve"
CONFLICT_KEYWORDS="conflict, clash, overlap"
WEATHER_KEYWORDS="weather, rain, forecast, temperature, umbrella"